#!/usr/bin/env bash
set -euo pipefail

# Both containers run as 1000:1000 and write to data/ (settings.json, btcd/).
APP_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
DATA_DIR="${APP_DIR}/data"

mkdir -p "${DATA_DIR}/btcd"
for dir in "${DATA_DIR}" "${DATA_DIR}/btcd"; do
	if [[ "$(stat -c "%u:%g" "${dir}")" != "1000:1000" ]]; then
		chown 1000:1000 "${dir}"
	fi
done
